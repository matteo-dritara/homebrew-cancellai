{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cancellai.dev/schemas/epic.schema.json",
  "title": "cancellAI epic and story contract",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "phase",
    "title",
    "objective",
    "dependencies",
    "status",
    "stories"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^E[0-9]{2}$"
    },
    "phase": {
      "type": "string",
      "pattern": "^P[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "planned",
        "ready",
        "in_progress",
        "ready_for_review",
        "verification",
        "blocked",
        "done",
        "done_no_release",
        "cancelled"
      ]
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "outcome",
          "change_risk",
          "dependencies",
          "acceptance_criteria",
          "safety_obligations",
          "verification",
          "documentation_impact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]{2}-S[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "ready",
              "in_progress",
              "verification",
              "blocked",
              "done",
              "cancelled"
            ]
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "change_risk": {
            "enum": [
              "CR0",
              "CR1",
              "CR2",
              "CR3",
              "CR4"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "safety_obligations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SI-[0-9]{3}$"
            }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "documentation_impact": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocked_by": {
            "type": "object",
            "description": "What holds a blocked item, and where the argument for it lives. Required when status is 'blocked' and refused otherwise: a status nobody can interrogate is a status nobody can act on, and a reason left behind on an unblocked item is worse than none.",
            "required": [
              "summary",
              "argument",
              "recorded"
            ],
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "waiting_on": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Work item ids this is waiting for, when the block is a sequencing one the dependencies field cannot express."
              },
              "argument": {
                "type": "string",
                "description": "Where the reasoning lives, as a repository path."
              },
              "recorded": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "blocked_by": {
      "type": "object",
      "description": "What holds a blocked item, and where the argument for it lives. Required when status is 'blocked' and refused otherwise: a status nobody can interrogate is a status nobody can act on, and a reason left behind on an unblocked item is worse than none.",
      "required": [
        "summary",
        "argument",
        "recorded"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "waiting_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Work item ids this is waiting for, when the block is a sequencing one the dependencies field cannot express."
        },
        "argument": {
          "type": "string",
          "description": "Where the reasoning lives, as a repository path."
        },
        "recorded": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  },
  "additionalProperties": false
}
