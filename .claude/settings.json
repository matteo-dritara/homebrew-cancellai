{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-generated-docs.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git push origin main)",
      "Bash(git push)"
    ]
  }
}
