# Normalize line endings in the repository. The Claude history rewriter preserves the
# bytes it reads, so test fixtures that assert on CRLF must not be rewritten by Git.
* text=auto eol=lf

*.png binary
*.jpg binary
*.gz binary

# Generated from the machine-readable control plane; do not hand-edit.
docs/BACKLOG.md linguist-generated=true
docs/ROADMAP.md linguist-generated=true
